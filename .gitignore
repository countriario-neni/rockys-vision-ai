# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# netlify cli local state
.netlify/

# playwright
/test-results/
/playwright-report/
/blob-report/


# Local audit artifacts (Lighthouse reports, theme screenshots)
lighthouse-*.json
*-theme.png

# Internal build notes — kept local, not published to the public repo
CLAUDE.md

# --- Secrets. This repository is PUBLIC: anything committed here is permanent and
# --- recoverable from history even after deletion. Nothing below ever gets committed.
# Env files in every form (the earlier .env* rule misses these)
.env
.env.*
*.env
.envrc
# Credential material
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
credentials.json
service-account*.json
secrets.json
secrets.*.yml
# Cal.com / provider API keys dropped into scratch files
cal_live_*
cal_test_*
*apikey*
*api-key*
*.secret
# Local tool state that can carry tokens
.netlify/
.vercel/
.wrangler/
.cal/
# Backups of live service config pulled down for editing
cal-*-backup.json
